{
    "compilerOptions": {
        "strict": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "target": "ESNext",
        "module": "Preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "noEmit": true
    }
}
