{
    "name": "quick-pic",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "serve": "bun run --hot src/index.ts",
        "build": "bun build ./src/index.ts --outdir=./dist --target=bun --minify",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "//-03a": "// ****************************************************************************",
        "//-03b": "// *** Check for Updates                                                       ",
        "//-03c": "// ****************************************************************************",
        "bupd": "bun update --interactive --recursive --format group --save",
        "//-0a": "// ****************************************************************************",
        "//-0b": "// *** DOCKER                                                                  ",
        "//-0c": "// ****************************************************************************",
        "docker:build": "docker build --target=deploy -f=.deploy/qp.Dockerfile -t quick-pic:latest .",
        "docker:run": "docker run -d -e PORT=$PORT -p $PORT:$PORT quick-pic:latest"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/bun": "1.3.14",
        "nx": "23.1.0",
        "typescript": "7.0.2"
    },
    "packageManager": "bun@1.3.14",
    "nx": {}
}
